# sandbox-openmc-source: OpenMC を MinGW-w64 でネイティブビルドし、sandbox-openmc の計算を
# Docker なしで回すためのビルドサンドボックス。ビルド設定・中間物・成果物はすべてこの
# ディレクトリ内に閉じる (src/ build/ prefix/ venv/ はすべて gitignore)。
#
#   make -C sandbox-openmc-source           # (デフォルト) ビルドし、環境設定ラッパーのパスを stdout に印字
#   make -C sandbox-openmc-source hdf5      # 段1: HDF5 (静的、C + HL)
#   make -C sandbox-openmc-source openmc    # 段2: openmc.exe
#   make -C sandbox-openmc-source venv      # 段3: uv 管理の python + openmc パッケージ
#   make -C sandbox-openmc-source check     # 実行環境の確認 (sandbox-openmc の env 相当)
#   make -C sandbox-openmc-source clean     # src/ build/ prefix/ venv/ を全削除
#
# 親からの使い方 (sandbox-mhd/epotFoam と同じイディオム: サブ makefile が toolchain を所有し、
# 親にはラッパーのパスを stdout で渡す)。ビルド出力は 1>&2 に流すので stdout は汚れない:
#
#   make -C sandbox-openmc compare \
#     OPENMC="$$(make -s --no-print-directory -C ../sandbox-openmc-source WORK=$$(pwd))"
#
# 断面積は sandbox-openmc/data/ の既存ライブラリを再利用する。ローカルビルドには njoy が
# 無いので `make -C sandbox-openmc data` (LIB=lite) は通らない (README の「既知の制約」参照)。

# Git Bash が cmake の引数中の Windows パス (-DCMAKE_INSTALL_PREFIX=C:/... など) を
# MSYS パスへ勝手に変換するのを防ぐ。個別コマンドに前置せずここで export して
# makefile 全体に効かせる (リポジトリ全体で使っている対処。
# sandbox-openmc/makefile と report.tex と同じ)。
export MSYS_NO_PATHCONV=1

HDF5_VER   ?= 2.1.1
OPENMC_REF ?= develop
PYTHON_VER ?= 3.12
JOBS       ?= 8

# 親 (sandbox-openmc) の場所。断面積 XML の既定値をここから導く
WORK ?= $(abspath $(CURDIR)/../sandbox-openmc)
XS   ?= $(WORK)/data/lib/cross_sections.xml

# $(CURDIR) は MinGW make が Windows 形式 (C:/...) で返すので cmake.exe にそのまま渡せる。
# 一方 PATH は bash 側で組むので MSYS 形式 (/c/...) が要る → cygpath で変換する。
SRC    := $(CURDIR)/src
BUILD  := $(CURDIR)/build
PREFIX := $(CURDIR)/prefix
VENV   := $(CURDIR)/venv

# ?= ではなく = にすること。GNU Make は CC/CXX に組み込みデフォルト (cc /
# x86_64-w64-mingw32-g++) を持っており、?= だと「定義済み」扱いで発火せず、
# 存在しない cc を掴んで configure が落ちる。= ならコマンドライン指定は依然優先される。
CC     = gcc
CXX    = g++

# MinGW の math.h は strict ANSI だと M_PI を隠す。OpenMC は CXX_EXTENSIONS OFF で
# -std=c++17 (gnu++17 ではない) を選ぶため該当する。mesh.cpp:6 は _USE_MATH_DEFINES を
# 定義しているが 1 行目の openmc/mesh.h 経由で math.h が先に読まれ手遅れになる。
# コマンドラインで定義すれば最初の include より前に効く (plot.cpp, quartic_solver.cpp も同様)。
OPENMC_CXX_FLAGS ?= -D_USE_MATH_DEFINES

# libopenmc を静的ライブラリにする (patches/openmc-static-lib.patch)。上流の CMakeLists は
# MSVC のときだけ STATIC を選び、それ以外は SHARED にするので、MinGW も STATIC 側へ寄せる。
# 結果 openmc.exe は libopenmc.dll を必要としなくなり、-static だけで完全に自己完結する。
#
# -static 単独で足りる。SHARED のままだと話が複雑になる (MinGW の ld が DLL の全シンボルを
# 自動エクスポートするため _Unwind_Resume が DLL から出て、exe 側の静的 libgcc_eh.a と
# multiple definition になる。回避には --exclude-libs でランタイムのアーカイブだけを
# 名指しする必要があり、さらに libwinpthread は絶対パス指定が要った)。
# STATIC にするとその問題自体が消えるので、実測でフラグを1つまで削れた。
#
# -static-libgcc -static-libstdc++ では足りない (実測: libwinpthread-1.dll が残る)。
# winpthread には -static-libpthread 相当が無いため、-static でまとめて倒す。
OPENMC_EXE_LDFLAGS ?= -static

# patches/*.patch を全部当てる。適用済みなら黙って飛ばす (.PHONY なので毎回このレシピに
# 入るため、--reverse --check が通る = すでに当たっている、という判定にする)。
# cmake の configure より前に当てる必要がある (CMakeLists.txt を書き換えるため)。
PATCHES = $(sort $(wildcard $(CURDIR)/patches/*.patch))
APPLY_PATCHES = for p in $(PATCHES); do \
	  if git -C $(SRC)/openmc apply --reverse --check "$$p" 2>/dev/null; then \
	    echo "$$(basename $$p): already applied" >&2; \
	  else \
	    git -C $(SRC)/openmc apply "$$p" $(E) || exit 1; \
	    echo "$$(basename $$p): applied" >&2; \
	  fi; \
	done

HDF5_URL   = https://github.com/HDFGroup/hdf5/releases/download/$(HDF5_VER)/hdf5-$(HDF5_VER).tar.gz
OPENMC_URL = https://github.com/openmc-dev/openmc.git

OPENMC_EXE = $(PREFIX)/bin/openmc.exe

# 実験: ジェネレータ指定を外す (CMAKE_GENERATOR_ARG を空にする)
CMAKE_GENERATOR_ARG ?=

# ジェネレータは "MinGW Makefiles" (make はシステムに入っている前提)。
# 古い CMake は sh.exe が PATH にいると "sh.exe was found in your PATH" でこの
# ジェネレータを拒否したが、3.31 では Git Bash 上でも configure/build とも通る (実測)。
# なお "MSYS Makefiles" はコンパイラ検査の時点で落ちるので使わない。
CMAKE_COMMON = $(CMAKE_GENERATOR_ARG) \
               -DCMAKE_BUILD_TYPE=Release \
               -DCMAKE_C_COMPILER=$(CC) -DCMAKE_CXX_COMPILER=$(CXX) \
               -DCMAKE_INSTALL_PREFIX=$(PREFIX)

# 全ビルド出力を 1>&2 に流すのは、デフォルトターゲット openmc-env が stdout に
# ラッパーのパスだけを出す必要があるため (sandbox-mhd/epotFoam:36 と同じ理由)。
E = 1>&2

.PHONY: openmc-env hdf5 openmc venv check clean

# ---- デフォルト: ビルドし、環境を設定して exec するラッパーの *パス* を stdout に出す ----
#
# 起動プレフィックス (`env PATH=... `) を1行で印字する方式は使えない。Windows の PATH には
# 空白を含む要素があり、親側でコマンド置換として展開されると単語分割される。置換結果は
# 引用符が再解釈されないのでクォートでも防げない。空白を含まないパス1個なら原理的に安全。
#
# ランタイムを静的に畳んだので、実行時に MinGW の PATH は要らなくなった
# (実測: PATH から mingw を除いても openmc.exe --version と import openmc.lib が通る)。
# 以前は libopenmc.dll が libstdc++-6 等に動的リンクしており、見つからないと
# openmc.exe が無言で 127 で落ちていた (DLL 解決失敗は Windows のローダ段階なので
# stderr に何も残らない)。
ENV_SH := $(PREFIX)/bin/openmc-env

openmc-env: venv
	@mkdir -p $(dir $(ENV_SH))
	@{ echo '#!/bin/sh'; \
	   echo '# generated by sandbox-openmc-source/makefile - do not edit'; \
	   echo 'PATH="'"$$(cygpath -u $(PREFIX)/bin)"':'"$$(cygpath -u $(VENV)/Scripts)"':$$PATH"'; \
	   echo 'export PATH'; \
	   echo 'OPENMC_CROSS_SECTIONS="$(XS)"'; \
	   echo 'export OPENMC_CROSS_SECTIONS'; \
	   echo 'exec "$$@"'; } > $(ENV_SH)
	@chmod +x $(ENV_SH)
	@echo $(ENV_SH)

# ================= 段1: HDF5 =================
#
# 静的ビルド (BUILD_SHARED_LIBS=OFF) にして Windows の DLL シンボル export 問題を丸ごと回避する。
# OpenMC は C API と HL のみ使い C++ API は使わないので HDF5_BUILD_CPP_LIB=OFF。
#
# zlib (deflate フィルタ) は無効にする。HDF5 2.x の既定も OFF。
hdf5:
	@command -v cmake >/dev/null \
	  || { echo "cmake not found in PATH; install it and retry" >&2; exit 1; }
	@# 展開済みなら取り直さない (.PHONY なので毎回このレシピに入るため、ここで自前に判定する)。
	@mkdir -p $(SRC)
	@test -f $(SRC)/hdf5-$(HDF5_VER)/CMakeLists.txt \
	  || (cd $(SRC) && curl -fL -o hdf5.tar.gz $(HDF5_URL) $(E) \
	      && tar xzf hdf5.tar.gz && rm -f hdf5.tar.gz)
	cmake -S $(SRC)/hdf5-$(HDF5_VER) -B $(BUILD)/hdf5 $(CMAKE_COMMON) \
	  -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON \
	  -DBUILD_TESTING=OFF -DHDF5_BUILD_EXAMPLES=OFF -DHDF5_BUILD_TOOLS=OFF \
	  -DHDF5_BUILD_HL_LIB=ON -DHDF5_BUILD_CPP_LIB=OFF -DHDF5_BUILD_FORTRAN=OFF \
	  -DHDF5_ENABLE_THREADSAFE=OFF -DHDF5_ENABLE_SZIP_SUPPORT=OFF \
	  -DHDF5_ENABLE_ZLIB_SUPPORT=OFF $(E)
	cmake --build $(BUILD)/hdf5 -j $(JOBS) $(E)
	cmake --install $(BUILD)/hdf5 $(E)

# ================= 段2: OpenMC =================
# 必須外部依存は HDF5 だけ。vendor/ の submodule は pugixml/fmt/Catch2 の3つ。
# OPENMC_FORCE_VENDORED_LIBS=ON で野良 pugixml/fmt の ABI 不一致を避ける。
# OpenMP はまず OFF で通してから ON にする (MinGW の libgomp は成熟しているので後で戻せる)。
openmc: hdf5
	@mkdir -p $(SRC)
	@# clone 済みなら取り直さない (.PHONY なので毎回このレシピに入る)。
	@# --depth 1 だけだとタグが無く git describe が失敗し、CMake の GetVersionFromGit が
	@# バージョンを 0.0.0 にしてしまう (openmc --version の表示と python 側の版が食い違う)。
	@# タグと、タグに到達できるだけの履歴を後追いで取る。develop は直近タグから
	@# 200 コミット程度なので 2000 あれば十分 (実測: v0.15.3-211-g05d01274a)。
	@test -d $(SRC)/openmc/.git \
	  || (git clone --recurse-submodules --branch $(OPENMC_REF) --depth 1 \
	        $(OPENMC_URL) $(SRC)/openmc $(E) \
	      && git -C $(SRC)/openmc fetch --tags --deepen=2000 origin $(OPENMC_REF) $(E))
	@$(APPLY_PATCHES)
	cmake -S $(SRC)/openmc -B $(BUILD)/openmc $(CMAKE_COMMON) \
	  -DHDF5_ROOT=$(PREFIX) -DHDF5_PREFER_PARALLEL=FALSE \
	  -DOPENMC_USE_OPENMP=OFF -DOPENMC_BUILD_TESTS=OFF \
	  -DOPENMC_FORCE_VENDORED_LIBS=ON \
	  -DOPENMC_USE_DAGMC=OFF -DOPENMC_USE_MPI=OFF \
	  -DOPENMC_USE_LIBMESH=OFF -DOPENMC_USE_UWUW=OFF \
	  -DCMAKE_CXX_FLAGS="$(OPENMC_CXX_FLAGS)" \
	  -DCMAKE_EXE_LINKER_FLAGS="$(OPENMC_EXE_LDFLAGS)" $(E)
	cmake --build $(BUILD)/openmc -j $(JOBS) $(E)
	cmake --install $(BUILD)/openmc $(E)

# ================= 段3: Python 環境 =================
# ホストの python は Microsoft Store のスタブなので、uv でインタプリタごと用意する。
# openmc の python パッケージは ext_modules を持たないのでコンパイルは発生しない。
#
# 共有ライブラリを作らないので site-packages に置く DLL は無い。Python 側が使うのは
# XML 生成 (openmc.Material / Cell / Tally など) と結果読み出し (StatePoint、中身は h5py)
# だけで、どちらも純 Python。輸送計算は Model.run() が openmc.exe を subprocess 起動する。
#
# openmc.lib (ctypes バインディング) は共有ライブラリが無いので読めないが、
# patches/openmc-lib-optional.patch により Model.run() はそれを許容して先へ進む。
venv: openmc
	@# --allow-existing: .PHONY で毎回走るため。既存 venv があると uv venv は既定で落ちる。
	uv venv $(VENV) --python $(PYTHON_VER) --allow-existing $(E)
	uv pip install --python $(VENV) $(SRC)/openmc $(E)

# ================= 検証 =================
# sandbox-openmc の env ターゲットに対応するローカル版。
check: venv
	@echo "== local OpenMC build check =="
	@echo "-- openmc executable --"; "$(OPENMC_EXE)" --version
	@echo "-- python openmc --"; "$(VENV)/Scripts/python.exe" -c "import openmc; print(openmc.__version__)"
	@echo "-- cross sections --"; test -f "$(XS)" \
	  && echo "  found: $(XS)" \
	  || echo "  missing: $(XS)  (run 'make data' in sandbox-openmc via Docker, or use LIB=full)"

clean:
	rm -rf $(SRC) $(BUILD) $(PREFIX) $(VENV)
