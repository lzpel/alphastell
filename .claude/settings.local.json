      "Bash(curl -s \"https://docs.openmc.org/en/stable/pythonapi/generated/openmc.CollisionFilter.html\")",
      "Bash(gh issue *)",
      "Bash(git log *)",
      "Bash(gcc --version)",
      "Bash(g++ --version)",
      "Bash(cmake --version)",
      "Bash(ninja --version)",
      "Bash(git --version)",
      "Bash(gh auth *)",
